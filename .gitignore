# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Database files
*.db

# Media files
*.mp4
*.gif
*.webp

# But retain small, intentional test fixtures.
!tests/fixtures/
!tests/fixtures/**/*.gif
!tests/fixtures/**/*.webp
!tests/fixtures/**/*.mp4

# Virtual environments
.venv

# Environment files
.env

# Note files
*.txt
